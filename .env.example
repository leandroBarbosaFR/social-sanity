# Social Studio environment variables. Copy the relevant section to each app's env file
# (apps/web/.env.local, apps/sanity-app/.env, apps/studio/.env) or your hosting provider.
# Never commit real values. Anything without a NEXT_PUBLIC_/SANITY_APP_/SANITY_STUDIO_ prefix is server-only.

# ─── apps/web (Next.js backend) ───────────────────────────────────────────────────────────
# Sanity project the backend reads/writes.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Sanity API token with write access (Editor). Server-only.
SANITY_API_TOKEN=
# Organization that owns the project. Enables Content Agent (caption drafts, assistant); the agent
# runs with each signed-in user's own token, so no extra secret is needed.
SANITY_ORGANIZATION_ID=
INSTAGRAM_API_MODE=mock
# Supabase (token storage). The service role key bypasses RLS: server-only.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Meta app (Instagram API with Instagram Login). Use the *Instagram* app ID/secret shown under
# Instagram > API setup with Instagram login, not the Facebook app ID.
META_APP_ID=
META_APP_SECRET=
# Must exactly match a "Valid OAuth Redirect URI" in the Meta app.
META_REDIRECT_URI=http://localhost:3000/api/auth/instagram/callback

# AES-256-GCM key for access tokens: base64 of exactly 32 bytes. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Rotating it invalidates stored tokens (accounts must reconnect).
SOCIAL_TOKEN_ENCRYPTION_KEY=

# Shared HMAC secret between Sanity Functions and this backend (min. 32 chars). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_API_SECRET=

# Origins allowed to call the API from a browser (the Sanity app), comma-separated.
ALLOWED_APP_ORIGINS=http://localhost:3333,https://www.sanity.io
# Public URL of this backend (no trailing slash).
APP_BASE_URL=http://localhost:3000
# live | mock. mock skips Meta entirely and is refused when NODE_ENV=production.
INSTAGRAM_API_MODE=live

# ─── apps/sanity-app (Sanity App SDK) ─────────────────────────────────────────────────────
SANITY_APP_PROJECT_ID=
SANITY_APP_DATASET=production
SANITY_APP_ORGANIZATION_ID=
# URL of apps/web as seen from the browser.
SANITY_APP_WEB_URL=http://localhost:3000

# ─── apps/studio (Sanity Studio) ──────────────────────────────────────────────────────────
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=production



# ─── Sanity Functions / sanity.blueprint.ts (read at `npx sanity blueprints deploy`) ─────
SANITY_ORGANIZATION_ID=
SANITY_PROJECT_ID=
SANITY_DATASET=production
# Function secrets are NOT read from this file. Set them on the deployed functions:
#   npx sanity@latest functions env add schedule-posts WEB_BASE_URL https://<backend>
#   npx sanity@latest functions env add schedule-posts INTERNAL_API_SECRET <same as above>
#   npx sanity@latest functions env add publish-instagram WEB_BASE_URL https://<backend>
#   npx sanity@latest functions env add publish-instagram INTERNAL_API_SECRET <same as above>
# WEB_BASE_URL=
# INTERNAL_API_SECRET=

# ─── Reserved ─────────────────────────────────────────────────────────────────────────────
# Not used (AI features run on Sanity Content Agent).
OPENAI_API_KEY=
