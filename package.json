{
  "name": "social-studio",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24.11.0"
  },
  "scripts": {
    "dev:app": "pnpm --filter @social-studio/sanity-app dev",
    "dev:studio": "pnpm --filter @social-studio/studio dev",
    "dev:web": "pnpm --filter @social-studio/web dev",
    "workflows": "node --env-file-if-exists=.env node_modules/@sanity/workflow-cli/bin/run.js",
    "workflows:check": "pnpm workflows deploy --check",
    "workflows:deploy": "pnpm workflows deploy",
    "typecheck": "pnpm -r --workspace-concurrency=4 typecheck",
    "lint": "pnpm -r --workspace-concurrency=4 lint",
    "build": "pnpm -r build",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "test": "pnpm -r --if-present test"
  },
  "devDependencies": {
    "@sanity/blueprints": "0.27.0",
    "@sanity/workflow-blueprint": "0.35.0",
    "@sanity/workflow-cli": "0.35.0",
    "@sanity/workflow-engine": "0.35.0",
    "typescript": "6.0.3"
  }
}
